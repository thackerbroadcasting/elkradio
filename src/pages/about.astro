---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { ABOUT } from "@consts";

---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
    <Container>
      <h4 class="animate font-semibold text-black dark:text-white underline">
        About Us
      </h4>
      <br>
      <p class="animate">
        We're "Elk Radio", an internet-only station serving up only the best music selection this side of the Mississippi (there's a Mississippi river Internet equivalent, right?).
      </p>
      <br>
      <p class="animate">
        Don't let the name fool you, we aren't a country-music station. We keep it simple, with our focus on the rock and metal genres. Some might call us "metalcore" which is pretty accurate. It is up to you to determine our exact genre.
      </p>
      <br>
      <p class="animate">
        We're a non-profit station, which simply means we don't play ads or have any sort of membership program. We do this because we want to keep things simple and focus on what matters most: the music. So join us for a listen, and enjoy the breadth of music we have to offer!
      </p>
    </Container>
</PageLayout>
